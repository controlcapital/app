generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model expense {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @default(dbgenerated("auth.uid()")) @db.Uuid
  description    String    @db.VarChar
  category       String    @db.VarChar
  date           DateTime  @db.Date
  amount         Float
  payment_method String    @db.VarChar
  frequency      String    @db.VarChar
  reminder       String    @db.VarChar
  status         String    @db.VarChar
  updated_at     DateTime? @default(now()) @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}


model income {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @default(dbgenerated("auth.uid()")) @db.Uuid
  description String    @db.VarChar
  category    String    @db.VarChar
  amount      Float
  date        DateTime  @db.Date
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}


model users {
  id          String    @id(map: "user_pkey") @default(dbgenerated("auth.uid()")) @db.Uuid
  fullname    String    @db.VarChar
  email       String    @db.VarChar
  avatar      String?
  updated_at  DateTime  @default(now()) @db.Timestamp(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  expense     expense[]
  income      income[]
  suscription  suscription[]
}

model suscription {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @default(dbgenerated("auth.uid()")) @db.Uuid
  plan          String    @db.VarChar
  renewal_date  DateTime  @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamp(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
